<?xml version="1.0" encoding="utf-8"?>
<!-- 插件卡片（高峰）：18dp 圆角 + 暖黑渐变 + 1dp 描边，与谷时卡片同结构、只换色。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="315"
        android:endColor="#E82A1A06"
        android:startColor="#E81C1206"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#1F3046" />
</shape>
