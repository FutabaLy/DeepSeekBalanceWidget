<?xml version="1.0" encoding="utf-8"?>
<!--
  插件卡片（空闲/谷时）：18dp 圆角 + 深蓝黑渐变 + 1dp 描边。
  由 WidgetRenderer 用 setBackgroundResource(R.drawable.bg_widget_peak / bg_widget_off_peak) 动态切换。
  注意：绝对不能用 setBackgroundColor —— 那会把这张 shape 换成纯色，圆角和描边全部丢失（旧版本就是这样变方块的）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="315"
        android:endColor="#E8162B3F"
        android:startColor="#E80D1B2A"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#1F3046" />
</shape>
