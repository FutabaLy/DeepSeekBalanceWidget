<?xml version="1.0" encoding="utf-8"?>
<!--
  DeepSeek 余额桌面插件（4x2）。
  只有 RemoteViews 支持的控件与属性；所有可见文本都带 id，由代码按峰/谷状态动态填充。

  布局结构：
    ┌──────────────────────────────────────┐
    │  DeepSeek 余额            [谷] 5s前  │
    │  ¥ 109.29                            │
    │  距高峰 12:34:56   ────────  ↻        │
    │  赠金 ¥9.29 · 充值 ¥100.00            │
    └──────────────────────────────────────┘
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 第一行：标题 + 峰/谷徽章 + 同步时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title_default"
            android:textColor="#8FA6C0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:minWidth="30dp"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:text="@string/tier_off_short"
            android:textColor="#12D6A0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sync_idle"
            android:textColor="#7C90A8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 第二行：余额大字 -->
    <TextView
        android:id="@+id/tv_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_balance_placeholder"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold" />

    <!-- 第三行：倒计时 + 刷新按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_countdown_placeholder"
            android:textColor="#C6D6E8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#8FA6C0"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/action_refresh"
            android:padding="7dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- 第四行：赠金 / 充值余额明细（供宽版布局使用，窄版自动省略） -->
    <TextView
        android:id="@+id/tv_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#8FA6C0"
        android:textSize="10sp" />
</LinearLayout>
