<?xml version="1.0" encoding="utf-8"?>
<!--
  DeepSeek 余额桌面插件（4x2）。
  只有 RemoteViews 支持的控件与属性；所有可见文本都带 id，由代码按峰/谷状态动态填充。

  布局结构（与 docs/widget-preview.png 对应）：
    ┌────────────────────────────────────────┐  ← widget_root：18dp 圆角卡片 + 描边
    │▓▓ 顶部浅色带（widget_header）▓▓▓▓▓▓▓▓▓│  ← 背景分层：比卡片亮一档，上圆角与卡片一致
    │▓ DeepSeek 余额  (谷)  刚刚 · 5秒 ▓▓▓▓▓│
    │  ¥109.29                               │  ← 余额大字（垂直方向弹性区，自动居中）
    │  距高峰 11:42:07          国庆节 休  ↻ │
    │  赠金 ¥9.29 · 充值 ¥100.00              │
    └────────────────────────────────────────┘

  卡片/带的底色由 WidgetRenderer 用 setBackgroundResource 按峰谷切换，不要用 setBackgroundColor
  （那会把 shape 换成纯色，圆角、渐变、描边全部丢失）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_off_peak"
    android:baselineAligned="false"
    android:orientation="vertical">

    <!-- 第一层：顶部标题带（整条浅色，贴住卡片顶部与左右边缘） -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_off_peak"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/widget_title_default"
            android:textColor="#8FA6C0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_off_peak"
            android:gravity="center"
            android:minWidth="30dp"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/tier_off_short"
            android:textColor="#12D6A0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sync_idle"
            android:textColor="#7C90A8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 第二层：内容区（上下留白由余额大字这一弹性行吸收，卡片被拉高时数字仍居中） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- 余额大字：weight 让它在卡片变高时吸收多余高度，文字自身垂直居中 -->
        <TextView
            android:id="@+id/tv_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/widget_balance_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <!-- 倒计时 + 休/班标记 + 刷新按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 文案 + 等宽数字分开：秒数跳动时不会左右抖动 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_countdown_label_placeholder"
                    android:textColor="#C6D6E8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_countdown_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="@string/widget_countdown_placeholder"
                    android:textColor="#C6D6E8"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#8FA6C0"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/action_refresh"
                android:padding="7dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- 赠金 / 充值余额明细 -->
        <TextView
            android:id="@+id/tv_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#8FA6C0"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
