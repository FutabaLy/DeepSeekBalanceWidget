<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 紧凑插件布局（白底 + 蓝色描边，浅色主题）。

    ┌──────────────────────────┐
    │ DeepSeek 余额        (↻) │
    │ ¥29.10                   │
    │ 今日已用 ¥2.46            │
    │ (谷) 57:16:52            │
    └──────────────────────────┘

  只有 RemoteViews 支持的控件；背景与胶囊颜色由 CompactWidgetRenderer 按峰谷切换。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_compact_card"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="13dp"
    android:paddingEnd="15dp"
    android:paddingBottom="13dp">

    <!-- 第一行：标题 + 刷新按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/compact_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_black"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/widget_title_default"
            android:textColor="#3A55A8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/compact_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_compact_button"
            android:contentDescription="@string/action_refresh"
            android:padding="6dp"
            android:src="@drawable/ic_refresh_blue" />
    </LinearLayout>

    <!-- 第二行：余额大字。渐变字没法用 RemoteViews 上色，改由 GradientTextRenderer 画成位图 -->
    <ImageView
        android:id="@+id/compact_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/widget_balance_placeholder"
        android:scaleType="centerInside" />

    <!-- 第三行：今日已用（出错时显示错误信息） -->
    <TextView
        android:id="@+id/compact_used"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_black"
        android:maxLines="1"
        android:text="@string/widget_used_placeholder"
        android:textColor="#8A93A6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 第四行：峰/谷胶囊 + 倒计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/compact_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_compact_pill_off_peak"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:minWidth="26dp"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:text="@string/tier_off_short"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/compact_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_black"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/widget_countdown_placeholder"
            android:textColor="#2FA05A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
