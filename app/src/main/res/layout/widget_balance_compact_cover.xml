<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 紧凑插件的封面（第一层）：抠好的角色图铺在卡片上，点一下翻到数据面。

  图片本身是透明底（见 docs/make_cover.py），所以背景透出壁纸、没有底板；
  用 fitCenter 是为了整张图都露出来（centerCrop 会把两侧的头发裁掉）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/compact_cover_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_compact_cover_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/compact_cover" />
</FrameLayout>
