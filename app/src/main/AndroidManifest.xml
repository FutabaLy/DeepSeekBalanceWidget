<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 查询 DeepSeek 余额接口 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 常驻刷新服务（Android 8.0+ 前台服务必须配通知） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自动恢复刷新 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 引导用户把本应用加入电池优化白名单（小米/MIUI 保活关键） -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepSeekWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.DeepSeekWidget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面插件 1：4×2 大卡片（深色主题），configure 指向设置页，添加时先让用户填 Key -->
        <receiver
            android:name=".widget.BalanceWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>

        <!-- 桌面插件 2：2×2 紧凑卡片（浅色主题），与 4×2 共用同一份数据与刷新链路 -->
        <receiver
            android:name=".widget.CompactBalanceWidgetProvider"
            android:exported="false"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_compact_info" />
        </receiver>

        <!-- 插件按钮 / 通知按钮 -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.deepseek.balancewidget.action.REFRESH" />
                <action android:name="com.deepseek.balancewidget.action.TOGGLE_TIER" />
                <action android:name="com.deepseek.balancewidget.action.COMPACT_FLIP" />
                <action android:name="com.deepseek.balancewidget.action.NOTIF_REFRESH" />
                <action android:name="com.deepseek.balancewidget.action.NOTIF_TOGGLE_TIER" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 应用更新后恢复刷新 -->
        <receiver
            android:name=".widget.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.BalanceService"
            android:description="@string/service_description"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/service_special_use_reason" />
        </service>
    </application>
</manifest>
